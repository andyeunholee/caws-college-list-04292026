# Anthropic Claude API key — required
# Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: path to the Elite US College Data Sheet folder.
# Defaults to ./data/elite (bundled in the repo).
# Relative paths resolve from project root; absolute paths also accepted.
# ELITE_DATA_DIR=data/elite

# Optional: model override. Default is claude-sonnet-4-6.
# CLAUDE_MODEL=claude-sonnet-4-6
